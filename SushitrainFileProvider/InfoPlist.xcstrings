    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synctrain verbindet sich mit Gateways, die Ihre Ordner in Ihrem lokalen Netzwerk bereitstellen."
