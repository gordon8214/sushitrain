<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>SynctrainAppGroup</key>
	<string>$(SYNCTRAIN_APP_GROUP)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionFileProviderActions</key>
		<array>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>$(PRODUCT_BUNDLE_IDENTIFIER).keep</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>Keep on This Device</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>fileproviderItems.@count &gt; 0 AND SUBQUERY(fileproviderItems, $fileproviderItem, $fileproviderItem.userInfo.remoteFile == YES AND $fileproviderItem.userInfo.onDevice == NO).@count == fileproviderItems.@count</string>
			</dict>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>$(PRODUCT_BUNDLE_IDENTIFIER).stopKeeping</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>Stop Keeping on This Device</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>fileproviderItems.@count &gt; 0 AND SUBQUERY(fileproviderItems, $fileproviderItem, $fileproviderItem.userInfo.remoteFile == YES AND $fileproviderItem.userInfo.onDevice == YES AND $fileproviderItem.userInfo.localChange == NO).@count == fileproviderItems.@count</string>
			</dict>
		</array>
		<key>NSFileProviderDecorations</key>
		<array>
			<dict>
				<key>Identifier</key>
				<string>$(PRODUCT_BUNDLE_IDENTIFIER).conflict</string>
				<key>BadgeImageType</key>
				<string>com.apple.icon-decoration.badge.warning</string>
				<key>Category</key>
				<string>Badge</string>
				<key>Label</key>
				<string>Conflict Copy</string>
			</dict>
		</array>
		<key>NSExtensionFileProviderDocumentGroup</key>
		<string>$(SYNCTRAIN_APP_GROUP)</string>
		<key>NSExtensionFileProviderSupportsEnumeration</key>
		<true/>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.fileprovider-nonui</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).FileProviderExtension</string>
	</dict>
</dict>
</plist>
