<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>SynctrainAppGroup</key>
	<string>$(SYNCTRAIN_APP_GROUP)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionFileProviderActions</key>
		<array>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>$(PRODUCT_BUNDLE_IDENTIFIER).keep</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>Keep on This Device</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>fileproviderItems.@count &gt; 0 AND SUBQUERY(fileproviderItems, $fileproviderItem, $fileproviderItem.userInfo.selective == YES AND $fileproviderItem.userInfo.selected == NO AND $fileproviderItem.userInfo.folderRoot == NO).@count == fileproviderItems.@count</string>
			</dict>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>$(PRODUCT_BUNDLE_IDENTIFIER).stopKeeping</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>Stop Keeping on This Device</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>fileproviderItems.@count &gt; 0 AND SUBQUERY(fileproviderItems, $fileproviderItem, $fileproviderItem.userInfo.selective == YES AND $fileproviderItem.userInfo.selected == YES AND $fileproviderItem.userInfo.folderRoot == NO).@count == fileproviderItems.@count</string>
			</dict>
		</array>
		<key>NSExtensionFileProviderDocumentGroup</key>
		<string>$(SYNCTRAIN_APP_GROUP)</string>
		<key>NSExtensionFileProviderSupportsEnumeration</key>
		<true/>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.fileprovider-nonui</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).FileProviderExtension</string>
	</dict>
</dict>
</plist>
