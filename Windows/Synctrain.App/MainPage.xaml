<Page x:Class="Synctrain_App.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <NavigationView x:Name="Navigation" SelectionChanged="Navigate" IsBackButtonVisible="Collapsed" PaneDisplayMode="Auto">
  <NavigationView.MenuItems>
   <NavigationViewItem Content="Overview" Tag="overview" Icon="Home"/>
   <NavigationViewItem Content="Folders" Tag="folders" Icon="Folder"/>
   <NavigationViewItem Content="Devices" Tag="devices" Icon="OtherUser"/>
   <NavigationViewItem Content="Files" Tag="files" Icon="Document"/>
   <NavigationViewItem Content="Remote Files" Tag="gateway" Icon="World"/>
   <NavigationViewItem Content="Recovered Captures" Tag="recovery" Icon="Repair"/>
   <NavigationViewItem Content="Pending Changes" Tag="pending" Icon="Sync"/>
  </NavigationView.MenuItems>
  <Grid Padding="24" RowSpacing="16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}"/>
   <InfoBar x:Name="Error" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Error"/>
   <CommandBar x:Name="Commands" Grid.Row="2" DefaultLabelPosition="Right" Background="Transparent" HorizontalAlignment="Left"/>
   <ScrollViewer x:Name="BodyScroll" Grid.Row="3" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Body" Spacing="12" MaxWidth="1100" HorizontalAlignment="Stretch"/></ScrollViewer>
   <Grid Grid.Row="3" x:Name="FileBrowser" Visibility="Collapsed" RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBox x:Name="FileFilter" PlaceholderText="Filter this folder" TextChanged="FilterFiles" AutomationProperties.Name="Filter files"/>
    <ListView x:Name="FileList" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OpenFileRow">
     <ListView.ItemTemplate><DataTemplate>
      <Grid Padding="8" ColumnSpacing="16">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="{Binding Title}" FontSize="16" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
       <Button Grid.Column="1" Content="Open" Click="OpenFileButton" AutomationProperties.Name="{Binding OpenLabel}"/>
       <Button Grid.Column="2" Content="More" Click="FileActions" AutomationProperties.Name="{Binding ActionsLabel}"/>
      </Grid>
     </DataTemplate></ListView.ItemTemplate>
    </ListView>
   </Grid>
  </Grid>
 </NavigationView>
</Page>
