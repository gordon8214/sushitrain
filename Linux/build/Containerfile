# Builds Synctrain's GTK window and native Nautilus module against the Fedora 44 library baseline on hosts
# without the development packages. See Linux/build/build-window.sh.
FROM registry.fedoraproject.org/fedora:44
RUN dnf install -y --setopt=install_weak_deps=False gcc gtk4-devel libadwaita-devel gobject-introspection-devel \
		make nautilus-devel json-glib-devel pkgconf-pkg-config && dnf clean all
