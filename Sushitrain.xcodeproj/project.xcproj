  "targets": [
    {
      "name": "Synctrain",
      "id": "65AE11F82C39EE0E00E721D4",
      "product": "Products/Synctrain.app",
      "product-type": "application",
      "dependencies": [
        { "target": "SynctrainShare", "platforms": [ "macos" ] },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "product-name": "SynctrainHostKit",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "SushitrainGlass",
