        "CODE_SIGN_STYLE[config=Debug]": "Automatic",
        "CODE_SIGN_STYLE[config=Release]": "Automatic",
        "CODE_SIGN_STYLE[config=Release][sdk=macosx*]": "Manual",
        "CURRENT_PROJECT_VERSION": "85",
        "DEVELOPMENT_TEAM": "UF6P8KZZN4",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_APP_SANDBOX[sdk=macosx*]": "NO",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_HARDENED_RUNTIME[sdk=macosx*]": "YES",
        "ENABLE_INCOMING_NETWORK_CONNECTIONS": "YES",
        "ENABLE_INCOMING_NETWORK_CONNECTIONS[sdk=macosx*]": "NO",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS": "YES",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS[sdk=macosx*]": "NO",
        "ENABLE_RESOURCE_ACCESS_AUDIO_INPUT": "NO",
        "ENABLE_RESOURCE_ACCESS_CALENDARS": "NO",
        "ENABLE_RESOURCE_ACCESS_CAMERA": "NO",
        "ENABLE_RESOURCE_ACCESS_CONTACTS": "NO",
        "ENABLE_RESOURCE_ACCESS_LOCATION": "NO",
        "ENABLE_RESOURCE_ACCESS_PHOTO_LIBRARY": "YES",
        "ENABLE_USER_SELECTED_FILES": "readwrite",
        "ENABLE_USER_SELECTED_FILES[sdk=macosx*]": "",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Sushitrain/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Synctrain",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "YES",
        "INFOPLIST_KEY_ITSEncryptionExportComplianceCode": "c725a5cb-2954-4d01-9fe0-cb53e270346e",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.productivity",
        "INFOPLIST_KEY_LSSupportsOpeningDocumentsInPlace": "YES",
        "INFOPLIST_KEY_NSAppleEventsUsageDescription": "Synctrain asks System Events to remove Syncthing.app's login item when it takes over Syncthing's setup.",
        "INFOPLIST_KEY_NSCameraUsageDescription": "Using the camera you can easily add devices by scanning a QR code. It is still possible to add devices manually without the camera.",
        "INFOPLIST_KEY_NSDesktopFolderUsageDescription": "Synctrain synchronizes the folders you add, including those on your desktop.",
        "INFOPLIST_KEY_NSDocumentsFolderUsageDescription": "Synctrain synchronizes the folders you add, including those in your Documents folder.",
        "INFOPLIST_KEY_NSDownloadsFolderUsageDescription": "Synctrain synchronizes the folders you add, including those in your Downloads folder, and saves files you download there.",
        "INFOPLIST_KEY_NSNetworkVolumesUsageDescription": "Synctrain synchronizes the folders you add, including those on network volumes.",
        "INFOPLIST_KEY_NSPhotoLibraryUsageDescription": "When enabled, the app can load photos from the photo library and add them to synchronized folders.",
        "INFOPLIST_KEY_NSRemovableVolumesUsageDescription": "Synctrain synchronizes the folders you add, including those on external disks.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "IPHONEOS_DEPLOYMENT_TARGET": "27.0",
        "LD_RUNPATH_SEARCH_PATHS": [
